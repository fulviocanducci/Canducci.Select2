<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <LangVersion>8.0</LangVersion>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <PackageId>Canducci.Select2</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Title>Canducci.Select2</Title>
        <Authors>Fulvio Canducci</Authors>
        <Company>Canducci</Company>
        <Description>ASP.NET Core MVC model binding for Select2 requests and extension methods to convert IEnumerable and asynchronous IQueryable sources into Select2 items.</Description>
        <Copyright>Copyright © 2026 Fulvio Canducci</Copyright>
        <PackageProjectUrl>https://github.com/fulviocanducci/Canducci.Select2</PackageProjectUrl>
        <RepositoryUrl>https://github.com/fulviocanducci/Canducci.Select2</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>select2;aspnetcore;mvc;modelbinder;ienumerable;iqueryable;entityframeworkcore;dropdown;ajax</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>images/icon.png</PackageIcon>
        <PackageReleaseNotes>Initial release of Canducci.Select2.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\images\icon.png" Pack="true" PackagePath="images\" />
    </ItemGroup>
</Project>
